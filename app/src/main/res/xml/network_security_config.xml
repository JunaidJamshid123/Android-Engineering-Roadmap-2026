<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Release: HTTPS only. No cleartext exceptions.
      Certificate pinning is enforced in OkHttp via SSLPinningConfig.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
